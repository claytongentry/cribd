#!/bin/sh

set +x
set -eu

error() {
  printf '%s\n' "cribd: $1" >&2
  exit 1
}

command -v container >/dev/null 2>&1 ||
  error "Apple's container CLI is required. Install container 1.0 or later."

project_dir=$(CDPATH= cd -- "${0%/*}/.." && pwd)
host=${CRIBD_HOST:-127.0.0.1}
media_name=cribd-media
viewer_name=cribd-viewer
started=
log_pid=

# Prefix exported overrides so empty values still take precedence.
rtsp_override=${CRIBD_RTSP_URL+x}${CRIBD_RTSP_URL-}
adapter_override=${CRIBD_ADAPTER+x}${CRIBD_ADAPTER-}

if [ -f "$project_dir/.env" ]; then
  . "$project_dir/.env"
fi
[ -z "$rtsp_override" ] || CRIBD_RTSP_URL=${rtsp_override#x}
[ -z "$adapter_override" ] || CRIBD_ADAPTER=${adapter_override#x}

case "${CRIBD_RTSP_URL-}" in
  rtsp://* | rtsps://*) rtsp_url=$CRIBD_RTSP_URL ;;
  "") error "set CRIBD_RTSP_URL in .env or the environment." ;;
  *) error "CRIBD_RTSP_URL must use rtsp:// or rtsps://." ;;
esac

adapter=${CRIBD_ADAPTER:-direct}
case "$adapter" in
  direct)
    media_image=docker.io/bluenviron/mediamtx:1.20.0
    MTX_PATHS_CRIB_SOURCE=$rtsp_url
    ;;
  reolink)
    media_image=docker.io/bluenviron/mediamtx:1.20.0-ffmpeg
    MTX_PATHS_CRIB_SOURCE=publisher
    [ -x "$project_dir/adapters/reolink/stream" ] ||
      error "Reolink adapter is missing or not executable."
    ;;
  *) error "CRIBD_ADAPTER must be 'direct' or 'reolink'." ;;
esac

unset CRIBD_RTSP_URL CRIBD_ADAPTER CRIBD_HOST \
  rtsp_override adapter_override

container system start

for name in "$media_name" "$viewer_name"; do
  if container inspect "$name" >/dev/null 2>&1; then
    error "container '$name' already exists. Stop or remove it manually."
  fi
done

cleanup() {
  status=$?
  trap - 0 1 2 15

  if [ -n "$log_pid" ]; then
    kill "$log_pid" >/dev/null 2>&1 || true
  fi
  for name in $started; do
    container stop "$name" >/dev/null 2>&1 || true
  done
  if [ -n "$log_pid" ]; then
    wait "$log_pid" 2>/dev/null || true
  fi

  exit "$status"
}

container_running() {
  container inspect "$1" 2>/dev/null |
    grep -Eq '"state"[[:space:]]*:[[:space:]]*"running"'
}

trap cleanup 0
trap 'exit 129' 1
trap 'exit 130' 2
trap 'exit 143' 15

export MTX_PATHS_CRIB_SOURCE

set -- --detach --rm --name "$media_name" \
  --env MTX_PATHS_CRIB_SOURCE \
  --env "MTX_WEBRTCADDITIONALHOSTS=$host" \
  --publish "$host:8890:8889/tcp" \
  --publish "$host:8189:8189/udp"

if [ "$adapter" = reolink ]; then
  CRIBD_RTSP_URL=$rtsp_url
  export CRIBD_RTSP_URL
  set -- "$@" \
    --env CRIBD_RTSP_URL \
    --env MTX_PATHS_CRIB_RUNONINIT=/adapter/stream \
    --env MTX_PATHS_CRIB_RUNONINITRESTART=true \
    --mount "type=bind,source=$project_dir/adapters/reolink,target=/adapter,readonly"
fi

container run "$@" "$media_image" >/dev/null
started=$media_name
unset CRIBD_RTSP_URL MTX_PATHS_CRIB_SOURCE rtsp_url

container run --detach --rm --read-only --name "$viewer_name" \
  --mount "type=bind,source=$project_dir/web,target=/www,readonly" \
  --publish "$host:8889:8080/tcp" \
  docker.io/library/busybox:1.37.0 \
  httpd -f -p 8080 -h /www >/dev/null
started="$viewer_name $started"

container logs --follow "$media_name" &
log_pid=$!

while :; do
  for name in "$media_name" "$viewer_name"; do
    container_running "$name" ||
      error "${name#cribd-} container stopped unexpectedly."
  done
  sleep 1
done
