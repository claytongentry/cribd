#!/bin/sh

set +x
set -eu

error() {
  printf '%s\n' "cribd: $1" >&2
  exit 1
}

command -v container >/dev/null 2>&1 ||
  error "Apple's container CLI is required. Install container 1.0 or later."

project_dir=$(CDPATH= cd -- "${0%/*}/.." && pwd)
host=${CRIBD_HOST:-127.0.0.1}

if [ "${CRIBD_RTSP_URL+x}" != x ] && [ -f "$project_dir/.env" ]; then
  . "$project_dir/.env"
fi

case "${CRIBD_RTSP_URL-}" in
  rtsp://* | rtsps://*) rtsp_url=$CRIBD_RTSP_URL ;;
  "") error "set CRIBD_RTSP_URL in .env or the environment." ;;
  *) error "CRIBD_RTSP_URL must use rtsp:// or rtsps://." ;;
esac

unset CRIBD_RTSP_URL CRIBD_HOST

container system start

exec container run --rm --name cribd-media \
  --env "MTX_PATHS_CRIB_SOURCE=$rtsp_url" \
  --env "MTX_WEBRTCADDITIONALHOSTS=$host" \
  --publish "$host:8889:8889/tcp" \
  --publish "$host:8189:8189/udp" \
  docker.io/bluenviron/mediamtx:1.20.0
